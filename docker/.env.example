# Docker Compose settings for docker/compose.dev.yaml and docker/compose.prod.yaml.
# Copy to docker/.env (git-ignored) and fill in. Compose reads it automatically.
# The framework's own settings live in the repository's .env (see ../.env.example).

# --- Postgres -----------------------------------------------------------------
# In development, use the same values in the repository's .env.
POSTGRES_DB=gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Read-only role the otel-agent collects Postgres metrics with.
POSTGRES_MONITOR_USER=otel_monitor
POSTGRES_MONITOR_PASSWORD=change-me-too
# Log statements slower than this (ms); -1 disables.
# POSTGRES_LOG_MIN_DURATION_MS=1000

# --- SeaweedFS S3 ---------------------------------------------------------------
# When both are set, the S3 gateway requires these credentials (always set them
# in production). In development, use the same values as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in the repository's .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SigNoz ---------------------------------------------------------------------
# Internal-only credentials (never published). Use URL-safe values, e.g.
# `openssl rand -hex 24`: they are embedded in connection URLs.
SIGNOZ_CLICKHOUSE_PASSWORD=change-me
SIGNOZ_METASTORE_PASSWORD=change-me

# --- Telemetry ------------------------------------------------------------------
DEPLOYMENT_ENVIRONMENT=development

# --- Published ports ------------------------------------------------------------
# SigNoz UI. Published on localhost by default; set SIGNOZ_UI_BIND=0.0.0.0 to
# reach it from other machines (prefer a reverse proxy with TLS).
# SIGNOZ_UI_BIND=127.0.0.1
# SIGNOZ_UI_PORT=8080
# Development only (published on 127.0.0.1).
# POSTGRES_HOST_PORT=5432
# S3_HOST_PORT=8333
# FILER_HOST_PORT=8888
# OTLP_GRPC_HOST_PORT=4317
# OTLP_HTTP_HOST_PORT=4318
# Production only: the framework API.
# FRAMEWORK_BIND=0.0.0.0
# FRAMEWORK_PORT=8000
# FRAMEWORK_ENV_FILE=../../.env

# --- Versions -------------------------------------------------------------------
# Pinned in the compose files; override only to step through an upgrade
# (see docker/README.md).
# POSTGRES_VERSION=18.6-trixie
# SEAWEEDFS_VERSION=4.52
# SIGNOZ_VERSION=v0.149.0
# SIGNOZ_COLLECTOR_VERSION=v0.144.15
# CLICKHOUSE_VERSION=25.12.5
# SIGNOZ_METASTORE_VERSION=16.15
# OTEL_AGENT_VERSION=0.164.0
# FRAMEWORK_VERSION=latest
