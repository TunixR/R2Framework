{
  "routers": [
    {
      "model_name": "$PROVIDER_MODEL",
      "api_key": "$PROVIDER_API_KEY",
      "api_endpoint": "$PROVIDER_API_BASE",
      "provider_type": "OPENROUTER",
      "capabilities": ["TEXT"]
    },
    {
      "model_name": "$PROVIDER_VISION_MODEL",
      "api_key": "$FREE_PROVIDER_API_KEY",
      "api_endpoint": "$PROVIDER_API_BASE",
      "provider_type": "OPENROUTER",
      "capabilities": ["TEXT", "VISION"],
      "vision_backbone": "OTHER"
    },
    {
      "model_name": "$PROVIDER_VISION_TOOL_MODEL",
      "api_key": "$FREE_PROVIDER_API_KEY",
      "api_endpoint": "$PROVIDER_API_BASE",
      "provider_type": "OPENROUTER",
      "capabilities": ["TEXT", "VISION"],
      "vision_backbone": "OTHER"
    },
    {
      "model_name": "$PROVIDER_GROUNDING_MODEL",
      "api_key": "$PROVIDER_API_KEY",
      "api_endpoint": "$PROVIDER_API_BASE",
      "provider_type": "OPENROUTER",
      "capabilities": ["TEXT", "VISION"],
      "vision_backbone": "$PROVIDER_GROUNDING_MODEL_BACKBONE"
    }
  ]
}
