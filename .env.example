# Framework settings, read by settings.py. Copy to .env and fill in.
# Docker service credentials live in docker/.env (see docker/README.md).

# Postgres: must match the database in docker/.env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# LLM provider: seeds the provider routers and agents (populate.py) and is used by evals
PROVIDER=openrouter/openai/anthropic/azure/googleai
PROVIDER_MODEL="qwen/qwen3-235b-a22b:free"
PROVIDER_VISION_MODEL="mistralai/mistral-small-3.2-24b-instruct:free"
PROVIDER_VISION_TOOL_MODEL="google/gemini-2.0-flash-exp:free"
PROVIDER_GROUNDING_MODEL="bytedance/ui-tars-1.5-7b"
PROVIDER_GROUNDING_MODEL_BACKBONE="QWEN2.5"  # OTHER, QWEN2.5, QWEN3.5 or QWEN3.8
PROVIDER_API_KEY=your_api_key
FREE_PROVIDER_API_KEY=your_free_tier_api_key
PROVIDER_API_BASE=https://api.openrouter.ai/v1
OLLAMA_URL=http://localhost:11434  # PROVIDER and OLLAMA_URL are read by settings.py but not used yet

# GUI agents and feature flags
MAX_GUI_IMAGES="5"
UI_ERROR_PLANNING="false"
UI_MID_AGENT="false"

# S3-compatible storage for screenshots: must match S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY in docker/.env
S3_URL="http://localhost:8333"
S3_BUCKET=your_bucket
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Auth: JWT signing for user sessions
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# Admin seed: administrator created or updated by populate.py
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Observability: OTLP export to the SigNoz collector from docker/compose.dev.yaml (see OBSERVABILITY.md)
OBSERVABILITY_ENABLED="true"
OTEL_SERVICE_NAME="r2framework-api"
OTEL_SERVICE_NAMESPACE="r2framework"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_TRACES_SAMPLER_ARG="1.0"
DEPLOYMENT_ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE=""
LOG_FILE_MAX_BYTES="10000000"
LOG_FILE_BACKUP_COUNT="5"
STRANDS_LOG_LEVEL="INFO"
TELEMETRY_MAX_TEXT_LENGTH="120"

# SigNoz access for tests/integration/observability only (not used by the app)
SIGNOZ_CLICKHOUSE_URL=""
SIGNOZ_CLICKHOUSE_CONTAINER="r2framework-signoz-clickhouse-1"
SIGNOZ_POLL_TIMEOUT="60"
